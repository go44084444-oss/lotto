DATABASE_URL=postgresql+psycopg://lotto:lotto@localhost:5432/lotto

# 주간 리셋 컷오버 (잠정값 — TODO(product): 정확한 시각 확정 필요)
WEEK_RESET_DAY_OF_WEEK=sat
WEEK_RESET_TIME=21:00
WEEK_RESET_TIMEZONE=Asia/Seoul

DEFAULT_WEEKLY_QUOTA=20

SUPERKTS_DOWNLOAD_URL=https://superkts.com/lotto/download
DHLOTTERY_API_URL=https://www.dhlottery.co.kr/common.do?method=getLottoNumber&drwNo={draw_no}

ADMIN_API_KEY=change-me-in-production

# JWT 서명 키 — 배포 시 반드시 실제 랜덤값으로 교체할 것(개발 기본값 그대로 쓰지 말 것)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=20160

# 프론트엔드(React) 출처. 콤마로 여러 개 지정 가능(로컬+배포 URL 등)
CORS_ALLOWED_ORIGINS=http://localhost:5173
